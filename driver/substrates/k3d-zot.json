{
  "distSpecVersion": "1.1.1",
  "storage": { "rootDirectory": "/var/lib/registry" },
  "http": { "address": "0.0.0.0", "port": "5000", "compat": ["docker2s2"] },
  "log": { "level": "info" },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        { "urls": ["https://index.docker.io"], "onDemand": true, "syncTimeout": "10m",
          "content": [{ "prefix": "**", "destination": "/docker.io" }] },
        { "urls": ["https://ghcr.io"], "onDemand": true, "syncTimeout": "10m",
          "content": [{ "prefix": "**", "destination": "/ghcr.io" }] },
        { "urls": ["https://quay.io"], "onDemand": true, "syncTimeout": "10m",
          "content": [{ "prefix": "**", "destination": "/quay.io" }] },
        { "urls": ["https://registry.k8s.io"], "onDemand": true, "syncTimeout": "10m",
          "content": [{ "prefix": "**", "destination": "/registry.k8s.io" }] }
      ]
    }
  }
}
