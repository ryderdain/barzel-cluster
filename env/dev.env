# env/dev.env — the environment definition of dev (ADR-0039): plain
# NAME=value lines, no secrets. An exported value wins for one run and is
# announced on stderr. Each section names the one reader of its keys. The
# selector key heads its section: change it, and the section goes with it.

# --- Environment-wide: the phases, the modes, kiesei.sh ---
BRZL_KIESEI_IMAGE=kiesei:local
BRZL_PORTAL_HOST=local.barzel.sh
BRZL_PORTAL_TLS=local-ca
BRZL_PORTAL_PORT=443
BRZL_PORTAL_NODE_PORT=30443
BRZL_PORTAL_CLUSTER_IP=10.43.0.43
BRZL_SIGN_ON_ORG=tzvat
BRZL_EXAMPLE_APP_NAME=chofesh
BRZL_EXAMPLE_APP_SRC=../chofesh
BRZL_WORKLOAD_FOLLOW=branch
BRZL_CONDUCTOR_IDLE_SECONDS=1800
BRZL_SYNC_SWITCH_ALLOWED=true
BRZL_SECRET_STORE_DIR=var/secret-store/dev
BRZL_LOG_STORE_DIR=var/log-store/dev

# --- Substrate local: driver/substrates/local.sh ---
BRZL_SUBSTRATE=local
BRZL_K3D_CLUSTER=brzl-dev
BRZL_K3D_SERVERS=1
BRZL_K3D_AGENTS=0
BRZL_K3D_API_PORT=6550
BRZL_K3S_IMAGE=rancher/k3s:v1.31.5-k3s1
BRZL_DOCKER_NETWORK=brzl-dev
BRZL_ZOT_NAME=brzl-zot
BRZL_ZOT_IMAGE=ghcr.io/project-zot/zot:v2.1.22
BRZL_ZOT_PORT=5001
BRZL_ZOT_VOLUME=brzl-zot-data
BRZL_DNS_NAME=brzl-dns
BRZL_DNS_IMAGE=coredns/coredns:1.14.1
BRZL_DNS_PORT=1053
BRZL_LOG_COLLECTOR_NAME=brzl-log-collector
BRZL_LOG_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.162.0

# --- Secret store openbao: driver/secret-stores/openbao.sh ---
# (it also reads BRZL_DOCKER_NETWORK and BRZL_K3D_CLUSTER: the store runs
# beside the local cluster)
BRZL_SECRET_STORE=openbao
BRZL_OPENBAO_NAME=brzl-openbao
BRZL_OPENBAO_IMAGE=openbao/openbao:2.7.1
BRZL_OPENBAO_PORT=8200
BRZL_OPENBAO_VOLUME=brzl-openbao-data
BRZL_OPENBAO_TRANSIT_KEY=brzl-dev

# --- Audit mode: driver/modes/audit.sh (it also reads BRZL_K3D_CLUSTER) ---
BRZL_AUDIT_PORT=3300
BRZL_AUDIT_LOKI_IMAGE=grafana/loki:3.6.11
BRZL_AUDIT_GRAFANA_IMAGE=grafana/grafana:13.0.1-security-01
